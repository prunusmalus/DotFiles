{
  //电池电量
  "battery": {
    "interval": 60,
    "states": {
      "critical": 20,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}% ",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "Заряд: {capacity}%\nЗаряд/разряд: {power}\nОсталось: {timeTo}\n---\nЗдоровье батареи: {health}%",
  },
  //时钟
  "clock": {
    "interval": 1,
    "format": "󰥔 {:%H:%M:%S}",
    "tooltip-format": "{:%Y/%m/%d %A}\n---\nЛКМ: часы\nПКМ: календарь",
    "max-length": 25,
    "on-click": "gnome-clocks",
    "on-click-right": "gnome-calendar",
  },
  "clock#date": {
    // "interval":
    "format": "󰸗 {:%m-%d}",
    // "timezone":
    // "timezones":
    // "locale":
    // "rotate":
    // "on-click":
    // "on-click-middle":
    // "on-click-right":
    // "on-scroll-up":
    // "on-scroll-down":
    // "smooth-scrolling-threshold":
    // "tooltip":
    "on-click": "gnome-calendar",
    "tooltip-format": "{:%Y/%m/%d %A}",
  },
  //正在运行的软件
  "tray": {
    "icon-size": 22,
    "spacing": 7,
    // 自定义图标
    //"icons": {
    //     "blueman": "/home/shorin/.config/waybar/logo/bluetooth.png",
    //},
  },
  //工作区和窗口名字
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰜋",
      "default": "",
    },
  },
  "niri/window": {
    "format": "{}",
    "rewrite": {
      "(.*) - Mozilla Firefox": "🌎 $1",
      "(.*) - zsh": "> [$1]",
    },
  },
  //网络和蓝牙
  "group/network-bluetooth": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "network",
      "bluetooth"
    ],
  },
  "network": {
    "format-disconnected": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-icons": {
      "disconnected": "󰤮",
      "wifi": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": "󰈀",
    },
    //鼠标悬浮在wifi图标上会显示wifi名称、信号强度、ip地址、设备名
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\nЛКМ: панель\nПКМ: расширенные настройки сети",
    "tooltip-format-ethernet": "{ifname} : {ipaddr}\n---\nЛКМ: панель\nПКМ: расширенные настройки сети",
    "tooltip-format-disconnected": "Сеть не подключена\n---\nЛКМ: панель\nПКМ: расширенные настройки сети",
    "on-click": "kitty --class network-tui -e ~/.config/waybar/scripts/select-network-tui.sh",
    "on-click-right": "nm-connection-editor",
  },
  "bluetooth": {
    //蓝牙关闭状态下的图标和鼠标悬浮时的提示
    "format-disabled": "󰂲",
    "tooltip-format-disabled": "ПКМ: включить Bluetooth",
    "format": "󰂯",
    "tooltip-format-on": "ЛКМ: панель\nПКМ: выключить Bluetooth",
    //连接状态下的图标和提示
    "format-connected": "󰂱",
    "tooltip-format-connected": "󰂱 {device_alias}\n---\nЛКМ: панель",
    //点击功能
    "on-click-right": "~/.config/waybar/scripts/toggle-bluetooth.sh",
    "on-click": "kitty --class bluetui  -e bluetui",
  },
  //左键循环切换性能模式
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Режим питания: {profile}\n---\nЛКМ: переключить режим",
    "tooltip": true,
    "format-icons": {
      "performance": "󱐋",
      "balanced": "",
      "power-saver": "",
    },
  },
  //截图
  "custom/screenshot": {
    "format": "",
    "tooltip-format": "ЛКМ: быстрый скриншот (в буфер)\nПКМ: меню длинного скриншота\nСКМ: меню скриншота",
    "on-click": "~/.config/waybar/scripts/screenshot.sh",
    "on-click-middle": "~/.config/waybar/scripts/power-screenshot.sh",
    "on-click-right": "wl-longshot-menu"
  },
  //录屏screenrec
  "custom/wfrec": {
    "exec": "~/.config/waybar/scripts/screenrec status-json",
    "return-type": "json",
    //"interval": 1,                 // 每秒刷新一次
    "signal": 9, // 与脚本里的 WAYBAR_SIG 对应
    "tooltip": true,
    "on-click": "shorin-screenrec-menu toggle", // 左键：开始/停止
    "on-click-right": "shorin-screenrec-menu stop"
  },
  //声音模块
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ],
  },
  "pulseaudio": {
    "tooltip-format": "ЛКМ: звук вкл/выкл\nПКМ: микрофон вкл/выкл\nСКМ: панель",
    "format": "{icon} {format_source} ",
    "format-bluetooth": " {format_source} ",
    "format-source": "{volume}%",
    "format-source-muted": "",
    "format-muted": " {format_source} ",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "bluetooth": "",
      // "speaker":"󰓃"
      "speaker": [
        "",
        "",
        ""
      ],
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-middle": "pavucontrol --tab=3",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  //多媒体
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "▶",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "toooltip": "{dynamic}",
    "enable-tooltip-len-limits": true,
  },
  //logo+程序启动器
  "custom/applauncher": {
    "tooltip-format": "ЛКМ: меню запуска приложений\nПКМ: терминал",
    "format": "",
    "on-click": "rofi -show drun",
    //"on-click": "fuzzel",
    "on-click-right":"kitty || ghostty || alacritty || foot || konsole",
    "on-click-middle": "~/.config/scripts/niri_auto_blur_bg.sh || pkill -f niri_auto_blur_bg.sh"
  },
  //电源菜单
  "group/powermenu": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/wlogout",
      "custom/reboot",
      "custom/logout",
      "custom/lockscreen",
    ],
  },
  "custom/wlogout": {
    "tooltip-format": "ЛКМ: выключить",
    "format": "󰐥",
    "on-click": "choice=$(echo -e '否\\n是' | fuzzel --dmenu --prompt '确定要关机吗？ ' --lines 2); [ \"$choice\" = '是' ] && notify-send '关机中...' && systemctl poweroff",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/lockscreen": {
    "tooltip-format": "ЛКМ: заблокировать",
    "format": "",
    "on-click": "hyprlock -c ~/.config/niri/hyprlock.conf || swaylock",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/reboot": {
    "tooltip-format": "ЛКМ: перезагрузить",
    "format": "",
    "on-click": "choice=$(echo -e '否\\n是' | fuzzel --dmenu --prompt '确定要重启吗？ ' --lines 2); [ \"$choice\" = '是' ] && notify-send '重启中...' && systemctl reboot",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/logout": {
    "tooltip-format": "ЛКМ: выйти из сессии",
    "format": "󰈆",
    "on-click": "niri msg action quit",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  //内屏亮度
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal",
  },
  "backlight": {
    "tooltip": true,
    "tooltip-format":"Яркость встроенного экрана",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
  },
  //调节外接屏幕亮度
  "group/ddcutil": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/ddcutil-day",
      "backlight/slider",
      "backlight",
      "custom/separator#1",
      "custom/ddcutil-sleep",
      "custom/ddcutil-night",
    ],
  },
  "custom/ddcutil-day": {
    "tooltip-format": "ЛКМ: яркость внешнего экрана 100%\nПКМ: переключить режим защиты глаз",
    "format": "󰃠",
    "on-click": "ddcutil --display 1 setvcp 10 100 ",
    "on-click-right": "~/.local/bin/toggle-wlsunset",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/ddcutil-night": {
    "tooltip-format": "ЛКМ: яркость внешнего экрана 65%",
    "format": "󰃟",
    "on-click": "ddcutil --display 1 setvcp 10 65 ",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/ddcutil-sleep": {
    "tooltip-format": "ЛКМ: яркость внешнего экрана 5%",
    "format": "󰃞",
    "on-click": "ddcutil --display 1 setvcp 10 5 ",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  //swaync通知模块
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/mako": {
    "format": "",
    "on-click": "makoctl restore",
  },
  //control-center 
  "custom/settings": {
    "format": "",
    "on-click": "better-control",
    "tooltip-format": "ЛКМ: центр настроек",
  },
  //获取屏幕颜色colorpicker
  "custom/colorpicker": {
    "tooltip": true,
    "format": "󱏜",
    "on-click": "hyprpicker -a && pw-play /usr/share/sounds/freedesktop/stereo/message.oga",
    "on-click-middle":"~/.config/scripts/matugen-select-type.sh",
    "on-click-right":"waypaper",
    "tooltip-format":"ЛКМ: взять цвет\nПКМ: переключить обои\nСКМ: переключить схему системы",
  },
  //音频可视化
  "custom/cava": {
    "tooltip": false,
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh",
    "on-click": "playerctl play-pause "
  },
  //禁止熄屏
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
    // 这一项设置启动waybar的时候自动禁止熄屏
    "start-activated":true,
    "tooltip-format-activated": "Автогашение экрана выключено",
    "tooltip-format-deactivated": "Автогашение экрана включено",
    "on-click-right": "~/.config/scripts/matugen-select-type.sh"
  },
  //分隔符󰇝 󱋱
  "custom/separator#1": {
    "format": "󱋱",
    "tooltip": false,
  },
  //archupdater
"custom/updates": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "",
      "updated": ""
    },
    "exec": "~/.config/waybar/scripts/check-updates.sh",
    "restart-interval": 0,
    "on-click": "kitty -e shorin sysup",
    "on-click-middle": "pkill -SIGUSR1 -f ~/.config/waybar/scripts/check-updates.sh",
    "on-click-right": "kitty --class floating-term  -e shorin checkallupdates" 
  },
  //隐私
  "privacy": {
    "icon-spacing": 10,
    "icon-size": 16,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
    ],
  },
  "cffi/niri-taskbar": {
    // module_path
    "module_path": "/usr/lib/waybar/libniri_taskbar.so",
    "apps": {
      "signal": [
        {
          "match": "\\([0-9]+\\)$",
          "class": "unread",
        },
      ],
    },
  },
  // dwl and mangowc
  "ext/workspaces": {
    "format": "{icon}",
    //"format-icons": {
    //        "active": "󰜋",
    //        "default": ""
    //    },
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true,
  },
  "dwl/window": {
    "format": "[{layout}]{title}",
  },
  //剪贴板
  "custom/clipboard":{
    "format":"󰅍",
    "on-click":"kitty --class cliphist-tui -e cliphist-tui",
    "on-click-middle":"pkill wl-paste || true && wl-paste --watch cliphist store && sleep 0.5 && systemctl restart --user clipsync-git",
    "on-click-right":"rm -f ~/.cache/cliphist/db",
    "tooltip-format":"ЛКМ: история буфера\nПКМ: очистить историю\nСКМ: перезапустить службу буфера"
  },
  // 壁纸切换
 "custom/wallpapers":{
    "format":"󰸉",
    "tooltip-format":"ЛКМ: переключить обои\nПКМ: случайные обои\nСКМ: скачать случайные аниме-обои",
    "on-click":"waypaper",
    "on-click-right":"waypaper --random",
    "on-click-middle":"~/.config/scripts/random-anime-wallpaper.sh"
 },
 // 常用命令
 "custom/actions":{
   "format":"",
    "tooltip-format":"ЛКМ: частые команды",
   "on-click":"~/.config/waybar/scripts/command-center.sh"
 }

}
