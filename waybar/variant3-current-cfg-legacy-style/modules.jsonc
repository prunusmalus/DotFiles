{
  // Battery
  "battery": {
    "interval": 60,
    "states": {
      "critical": 20,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}% ",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "Charge: {capacity}%\nPower: {power}\nTime left: {timeTo}\n---\nBattery health: {health}%",
  },
  // Clock
  "clock": {
    "interval": 1,
    "format": "󰥔 {:%H:%M:%S}",
    "tooltip-format": "{:%Y/%m/%d %A}\n---\nLMB: clocks\nRMB: calendar",
    "max-length": 25,
    "on-click": "gnome-clocks",
    "on-click-right": "gnome-calendar",
  },
  "clock#date": {
    // "interval":
    "format": "󰸗 {:%m-%d}",
    // "timezone":
    // "timezones":
    // "locale":
    // "rotate":
    // "on-click":
    // "on-click-middle":
    // "on-click-right":
    // "on-scroll-up":
    // "on-scroll-down":
    // "smooth-scrolling-threshold":
    // "tooltip":
    "on-click": "gnome-calendar",
    "tooltip-format": "{:%Y/%m/%d %A}",
  },
  // Tray (running apps)
  "tray": {
    "icon-size": 22,
    "spacing": 7,
    // Custom icons
    //"icons": {
    //     "blueman": "/home/shorin/.config/waybar/logo/bluetooth.png",
    //},
  },
  // Workspaces and window title
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰜋",
      "default": "",
    },
  },
  "niri/window": {
    "format": "{}",
    "rewrite": {
      "(.*) - Mozilla Firefox": "🌎 $1",
      "(.*) - zsh": "> [$1]",
    },
  },
  // Network and Bluetooth
  "group/network-bluetooth": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "network",
      "bluetooth"
    ],
  },
  "network": {
    "format-disconnected": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-icons": {
      "disconnected": "󰤮",
      "wifi": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": "󰈀",
    },
    // Hovering the wifi icon shows wifi name, signal strength, ip address, device name
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\nLMB: network panel\nRMB: advanced network settings",
    "tooltip-format-ethernet": "{ifname} : {ipaddr}\n---\nLMB: network panel\nRMB: advanced network settings",
    "tooltip-format-disconnected": "Network disconnected\n---\nLMB: network panel\nRMB: advanced network settings",
    "on-click": "kitty --class network-tui -e ~/.config/waybar/scripts/select-network-tui.sh",
    "on-click-right": "nm-connection-editor",
  },
  "bluetooth": {
    // Icon and tooltip when bluetooth is disabled
    "format-disabled": "󰂲",
    "tooltip-format-disabled": "RMB: enable Bluetooth",
    "format": "󰂯",
    "tooltip-format-on": "LMB: panel\nRMB: disable Bluetooth",
    // Icon and tooltip when connected
    "format-connected": "󰂱",
    "tooltip-format-connected": "󰂱 {device_alias}\n---\nLMB: panel",
    // Click actions
    "on-click-right": "~/.config/waybar/scripts/toggle-bluetooth.sh",
    "on-click": "kitty --class bluetui  -e bluetui",
  },
  // Left-click cycles power profile
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\n---\nLMB: cycle profile",
    "tooltip": true,
    "format-icons": {
      "performance": "󱐋",
      "balanced": "",
      "power-saver": "",
    },
  },
  // Screenshot
  "custom/screenshot": {
    "format": "",
    "tooltip-format": "LMB: quick screenshot (to clipboard)\nRMB: long screenshot menu\nMMB: screenshot menu",
    "on-click": "~/.config/waybar/scripts/screenshot.sh",
    "on-click-middle": "~/.config/waybar/scripts/power-screenshot.sh",
    "on-click-right": "wl-longshot-menu"
  },
  // Screen recording
  "custom/wfrec": {
    "exec": "~/.config/waybar/scripts/screenrec status-json",
    "return-type": "json",
    //"interval": 1,                 // refresh every second
    "signal": 9, // corresponds to WAYBAR_SIG in the script
    "tooltip": true,
    "on-click": "shorin-screenrec-menu toggle", // left: start/stop
    "on-click-right": "shorin-screenrec-menu stop"
  },
  // Audio
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ],
  },
  "pulseaudio": {
    "tooltip-format": "LMB: mute/unmute audio\nRMB: mute/unmute mic\nMMB: panel",
    "format": "{icon} {format_source} ",
    "format-bluetooth": " {format_source} ",
    "format-source": "{volume}%",
    "format-source-muted": "",
    "format-muted": " {format_source} ",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "bluetooth": "",
      // "speaker":"󰓃"
      "speaker": [
        "",
        "",
        ""
      ],
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-middle": "pavucontrol --tab=3",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  // Media
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "▶",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "toooltip": "{dynamic}",
    "enable-tooltip-len-limits": true,
  },
  // Logo + app launcher
  "custom/applauncher": {
    "tooltip-format": "LMB: app launcher menu\nRMB: terminal",
    "format": "",
    "on-click": "rofi -show drun",
    //"on-click": "fuzzel",
    "on-click-right":"kitty || ghostty || alacritty || foot || konsole",
    "on-click-middle": "~/.config/scripts/niri_auto_blur_bg.sh || pkill -f niri_auto_blur_bg.sh"
  },
  // Power menu
  "group/powermenu": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/wlogout",
      "custom/reboot",
      "custom/logout",
      "custom/lockscreen",
    ],
  },
  "custom/wlogout": {
    "tooltip-format": "LMB: shut down",
    "format": "󰐥",
    "on-click": "choice=$(echo -e 'No\\nYes' | fuzzel --dmenu --prompt 'Shut down? ' --lines 2); [ \"$choice\" = 'Yes' ] && notify-send 'Shutting down...' && systemctl poweroff",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/lockscreen": {
    "tooltip-format": "LMB: lock screen",
    "format": "",
    "on-click": "hyprlock -c ~/.config/niri/hyprlock.conf || swaylock",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/reboot": {
    "tooltip-format": "LMB: reboot",
    "format": "",
    "on-click": "choice=$(echo -e 'No\\nYes' | fuzzel --dmenu --prompt 'Reboot? ' --lines 2); [ \"$choice\" = 'Yes' ] && notify-send 'Rebooting...' && systemctl reboot",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/logout": {
    "tooltip-format": "LMB: log out",
    "format": "󰈆",
    "on-click": "niri msg action quit",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  // Internal display brightness
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal",
  },
  "backlight": {
    "tooltip": true,
    "tooltip-format":"Internal display brightness",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
  },
  // External display brightness
  "group/ddcutil": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/ddcutil-day",
      "backlight/slider",
      "backlight",
      "custom/separator#1",
      "custom/ddcutil-sleep",
      "custom/ddcutil-night",
    ],
  },
  "custom/ddcutil-day": {
    "tooltip-format": "LMB: external display brightness 100%\nRMB: toggle eye protection mode",
    "format": "󰃠",
    "on-click": "ddcutil --display 1 setvcp 10 100 ",
    "on-click-right": "~/.local/bin/toggle-wlsunset",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/ddcutil-night": {
    "tooltip-format": "LMB: external display brightness 65%",
    "format": "󰃟",
    "on-click": "ddcutil --display 1 setvcp 10 65 ",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/ddcutil-sleep": {
    "tooltip-format": "LMB: external display brightness 5%",
    "format": "󰃞",
    "on-click": "ddcutil --display 1 setvcp 10 5 ",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  // swaync notification module
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/mako": {
    "format": "",
    "on-click": "makoctl restore",
  },
  // control-center
  "custom/settings": {
    "format": "",
    "on-click": "better-control",
    "tooltip-format": "LMB: settings center",
  },
  // Color picker
  "custom/colorpicker": {
    "tooltip": true,
    "format": "󱏜",
    "on-click": "hyprpicker -a && pw-play /usr/share/sounds/freedesktop/stereo/message.oga",
    "on-click-middle":"~/.config/scripts/matugen-select-type.sh",
    "on-click-right":"waypaper",
    "tooltip-format":"LMB: pick color\nRMB: switch wallpaper\nMMB: switch system scheme",
  },
  // Audio visualizer
  "custom/cava": {
    "tooltip": false,
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh",
    "on-click": "playerctl play-pause "
  },
  // Inhibit screen-off
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
    // Start with screen-off inhibition enabled
    "start-activated":true,
    "tooltip-format-activated": "Auto screen-off disabled",
    "tooltip-format-deactivated": "Auto screen-off enabled",
    "on-click-right": "~/.config/scripts/matugen-select-type.sh"
  },
  // Separator
  "custom/separator#1": {
    "format": "󱋱",
    "tooltip": false,
  },
  // Arch updater
"custom/updates": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "",
      "updated": ""
    },
    "exec": "~/.config/waybar/scripts/check-updates.sh",
    "restart-interval": 0,
    "on-click": "kitty -e shorin sysup",
    "on-click-middle": "pkill -SIGUSR1 -f ~/.config/waybar/scripts/check-updates.sh",
    "on-click-right": "kitty --class floating-term  -e shorin checkallupdates" 
  },
  // Privacy
  "privacy": {
    "icon-spacing": 10,
    "icon-size": 16,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
    ],
  },
  "cffi/niri-taskbar": {
    // module_path
    "module_path": "/usr/lib/waybar/libniri_taskbar.so",
    "apps": {
      "signal": [
        {
          "match": "\\([0-9]+\\)$",
          "class": "unread",
        },
      ],
    },
  },
  // dwl and mangowc
  "ext/workspaces": {
    "format": "{icon}",
    //"format-icons": {
    //        "active": "󰜋",
    //        "default": ""
    //    },
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true,
  },
  "dwl/window": {
    "format": "[{layout}]{title}",
  },
  // Clipboard
  "custom/clipboard":{
    "format":"󰅍",
    "on-click":"kitty --class cliphist-tui -e cliphist-tui",
    "on-click-middle":"pkill wl-paste || true && wl-paste --watch cliphist store && sleep 0.5 && systemctl restart --user clipsync-git",
    "on-click-right":"rm -f ~/.cache/cliphist/db",
    "tooltip-format":"LMB: clipboard history\nRMB: clear history\nMMB: restart clipboard service"
  },
  // Wallpaper switcher
 "custom/wallpapers":{
    "format":"󰸉",
    "tooltip-format":"LMB: switch wallpaper\nRMB: random wallpaper\nMMB: download random anime wallpaper",
    "on-click":"waypaper",
    "on-click-right":"waypaper --random",
    "on-click-middle":"~/.config/scripts/random-anime-wallpaper.sh"
 },
 // Common commands
 "custom/actions":{
   "format":"",
    "tooltip-format":"LMB: frequent commands",
   "on-click":"~/.config/waybar/scripts/command-center.sh"
 }

}
