{
    "version": "2.0.3",
    "settings": {
        "enableDrop": false,
        "transition": {
            "enabled": true,
            "duration": 1000
        },
        "slideshow": {
            "enabled": false,
            "interval": 300000,
            "shuffle": true
        },
        "overwriteCSS": true,
        "accentColor": {
            "enabled": false,
            "color": "primary1"
        },
        "buttonLocation": {
            "location": "TitleBar",
            "position": "end"
        },
        "adjustment": {
            "xPosition": 0,
            "yPosition": 0,
            "dimming": 0,
            "blur": 0,
            "grayscale": 0,
            "saturate": 100,
            "contrast": 100
        },
        "addContextMenu": true
    }
}