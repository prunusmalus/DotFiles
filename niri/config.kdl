// This config is in the KDL format: https://kdl.dev
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

// ==================
// ENVIRONMENT VARS
// ==================
environment {
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    TERMINAL "kitty"
}

prefer-no-csd

cursor {
    xcursor-theme "macOS"
    xcursor-size 24
}


// ==================
// INPUT CONFIG
// ==================
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
        numlock
    }
    
    touchpad {
        tap
        natural-scroll
    }

    mouse {
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        scroll-method "on-button-down"
        scroll-button 274
    }

     focus-follows-mouse max-scroll-amount="0%"
}

// ==================
// MONITOR CONFIG
// ==================
output "DP-2" {
    mode "1920x1080@144"
    position x=0 y=0
    scale 1.0
    variable-refresh-rate 
}

// ==================
// GENERAL LAYOUT & DECORATION
// ==================
layout {
    gaps 10
    center-focused-column "never"
    
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 1.0; }

    /-focus-ring {
        width 2
        active-color "#4803FF"
        inactive-color "#7242F5"
    }

    focus-ring {
        width 1
        active-gradient from="#AECFE6" to="#F2A6A2" angle=45
        //active-gradient from="#AECFE6" to="#F2A6A2" angle=45
        inactive-gradient from="#2D3B54" to="#455A81" angle=45
    }

    border {
        off
    }

    // You can enable drop shadows for windows if desired
    shadow {
        // on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// ==================
// STARTUP APPS
// ==================
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "systemctl" "--user" "start" "hyprpolkitagent"
spawn-at-startup "awww-daemon"
spawn-at-startup "sh" "-c" "~/.config/niri/auto-resize.sh"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "clipcatd"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"




animations {
    // slowdown 3.0
}

// ==================
// WINDOW RULES
// ==================

window-rule {
    match is-active=true
    opacity 0.9
    draw-border-with-background false
}

window-rule {
    match is-active=false
    opacity 0.8
    draw-border-with-background false
}

window-rule {
    match app-id=r#"pavucontrol"# 
    open-floating true
}

window-rule {
    match app-id=r#"com.ayugram.desktop"#
    opacity 0.95
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"firefox"#
    opacity 0.95
}

window-rule {
    match app-id=r#"io.missioncenter.MissionCenter"#
    open-floating true
    opacity 0.7
    focus-ring {
        width 0
    }
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id=r#"org\.gnome\.Calculator"#
    open-floating true
    focus-ring {
        width 0
    }
    default-column-width { fixed 300;}
    default-window-height { fixed 500;}
}

window-rule {
    match app-id="discord"
}

// Your requested border radius and clipping
/-window-rule {
    geometry-corner-radius 25
    clip-to-geometry true
}


// ==================
// KEYBINDINGS
// ==================
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Application Launchers (Hyprland Config) ---
    Mod+T { spawn "kitty"; }
    Mod+Return { spawn "kitty" "--title" "main"; }
    Mod+Shift+Return { spawn "kitty" "--title" "floating"; }
    Mod+W { spawn "zen-browser"; }
    Mod+E { spawn "nautilus"; }
    Mod+Y { spawn "kitty" "yazi"; }
    Mod+B { spawn "blueman-manager"; }
    Mod+S { spawn "flatpak" "run" "com.spotify.Client"; }
    Mod+D { spawn "lutris"; }
    Mod+A { spawn "AyuGram"; }
    Mod+G { spawn "zen-browser" "https://www.gmail.com"; }
    Mod+M { spawn "flatpak" "run" "io.missioncenter.MissionCenter"; }
    Mod+N { spawn "swaync-client" "-t"; }
    Mod+X {spawn "./.config/bspwm/bin/PowerMenu" "c";}
    //Mod+X { spawn "niripwmenu"; }
    //Mod+X { spawn "wlogout" "-b" "6" "--layout" "~/.config/wlogout/layout" "--css" "~/.config/wlogout/style.css"; }
    //Mod+H { spawn "kitty nvim /home/prunus/.config/niri/config.kdl"; }
    Mod+Alt+S { spawn "steam"; }
    Mod+Shift+R { spawn "pavucontrol"; }
    Mod+Alt+V {spawn "viber";}
    Mod+H { spawn "kitty" "sh" "-c" "nvim /home/prunus/.config/niri/config.kdl"; }
    Mod+Shift+F {spawn "/home/prunus/.config/hypr/scripts/BookSelect.sh" "c";}
    Mod+L {spawn "hyprlock";}

    // --- Scripts & Menus ---
    Mod+R {spawn "rofi" "-show" "drun";}
    //Mod+R {spawn "/home/prunus/.config/hypr/bin/RofiLauncher"; }
    //Mod+Alt+C {spawn "clipcat-menu";}
    Mod+Alt+C { spawn "/home/prunus/.config/hypr/scripts/cliphist.sh" "c"; }
    Mod+Alt+W { spawn "/home/prunus/.config/hypr/scripts/cliphist.sh" "w"; }
    Mod+Alt+D { spawn "/home/prunus/.config/hypr/scripts/rofi-emoji.sh"; }
    Mod+Shift+Alt+W { spawn "/home/prunus/.config/hypr/scripts/Wallpaper.sh"; }
    Mod+Shift+D {spawn "/home/prunus/.config/hypr/scripts/idk.sh";}
    //Mod+Alt+D {spawn "/home/prunus/.config/hypr/scripts/rofi-emoji.sh";}
    Mod+Shift+W {spawn "/home/prunus/.config/hypr/scripts/WallpaperSelect.sh thm1";}
    Mod+C {spawn "kitty" "cava";}
    Mod+K {spawn "gnome-calculator";}

    // --- Audio & Brightness (XF86) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }

    Mod+Alt+X allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    Mod+Alt+Z allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }

    Mod+Shift+V          allow-when-locked=true {spawn "playerctl" "next";}
    Mod+Shift+C          allow-when-locked=true { spawn "playerctl" "play-pause"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // --- System Controls ---
    Mod+Tab repeat=false { toggle-overview; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+Alt+F { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+Shift+P { spawn "swaymsg" "output * dpms off"; } // Adjust as needed if not using Sway tools

    // --- Focus Navigation ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Alt+H     { focus-column-left; }
    Mod+Alt+L     { focus-column-right; }
    Mod+Alt+K     { focus-window-up; }
    Mod+Alt+J     { focus-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // --- Window Movement ---
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // --- Monitor Navigation ---
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-window-to-monitor-right; }

    // --- Workspace Navigation ---
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp   { focus-column-left; }

    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // --- Numbered Workspaces ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    
    Mod+Alt+1 { move-column-to-workspace 1; }
    Mod+Alt+2 { move-column-to-workspace 2; }
    Mod+Alt+3 { move-column-to-workspace 3; }
    Mod+Alt+4 { move-column-to-workspace 4; }
    Mod+Alt+5 { move-column-to-workspace 5; }

    // --- Screenshots (Grimblast / Quickshell / Niri Defaults) ---
    Print { spawn "grimblast" "copy" "area"; }
    Ctrl+Print { spawn "grimblast" "copy" "screen"; }
    Alt+Print { screenshot-window; }
    Mod+Shift+S { screenshot; }
    //Mod+Shift+S { spawn "quickshell" "-c" "/home/prunus/.config/quickshell/hyprquickshot/" "-n"; }

    // --- Sizing (Logical Pixels) ---
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // --- Other Niri Utilities ---
    Mod+Shift+Alt+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Toggle Inhibitor
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Quit actions
    //Mod+Shift+E {spawn ;}
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}
