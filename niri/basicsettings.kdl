// Generated by niri-settings - Edits will be overwritten!

// prefer-no-csd

overview {
    zoom 0.4
}

animations {
    on
    slowdown 1.0
}

layout {
    shadow {
    on
    }

    gaps 8
    default-column-display "normal"
    center-focused-column "never"
    // empty-workspace-above-first

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        on
        width 1
        active-gradient from="#F2A6A2" to="#FC90AA" angle=45
        //active-gradient from="#AECFE6" to="#F2A6A2" angle=45
        //inactive-gradient from="#2D3B54" to="#455A81" angle=45
        inactive-gradient from="#89b4fa"  to="#1e1e2e" angle=45
    }

    border {
        off
        width 1
        active-color "#7fc8ff"
        inactive-color "#fc90aa"
    }

    insert-hint {
        // off
        color "#fc90aa"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 0
        width 1
        length total-proportion=1.0
        gap 4
        gaps-between-tabs 2
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    draw-border-with-background false
} 

input {
    // warp-mouse-to-focus
    // focus-follows-mouse // max-scroll-amount="10%"
    // disable-power-key-handling
    // workspace-auto-back-and-forth
    mod-key "Super"
    
    touchpad {
        tap
        // dwt
        // dwtp
        natural-scroll
        drag false
        // drag-lock
        // disabled-on-external-mouse
        // left-handed
        click-method "button-areas"
        scroll-method "two-finger"
        accel-speed 0.20
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        scroll-factor 1.0
    }
    
    mouse {
        // natural-scroll
        // left-handed
        // middle-emulation
        accel-speed 0.20
        accel-profile "adaptive"
        scroll-factor 1.0
        scroll-method "on-button-down"
        scroll-button 274
    }
    
    keyboard {
        track-layout "global"
        numlock
        repeat-delay 600
        repeat-rate 25
    }
}

hotkey-overlay {
    hide-not-bound
    // skip-at-startup
    }

gestures {
    hot-corners {
        //off
        top-left
        top-right
        //bottom-left
        //bottom-right
    }
}

debug {
    // honor-xdg-activation-with-invalid-serial 
}

cursor {
    // hide-when-typing 
    // hide-after-inactive-ms {self.behavior_tab.inactive_spinbox.value()}
}

    // * do not show backups
